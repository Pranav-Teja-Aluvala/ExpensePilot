{
  "manifest_version": 3,
  "name": "ExpensePilot",
  "version": "1.0.0",
  "description": "Privacy-first expense tracker that auto-parses bank transaction emails from Gmail. All data stays on your device.",
  "permissions": ["storage", "identity", "alarms", "notifications"],
  "host_permissions": ["https://gmail.googleapis.com/*"],
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    },
    "default_title": "ExpensePilot"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "options_page": "pages/dashboard.html",
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "oauth2": {
    "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
